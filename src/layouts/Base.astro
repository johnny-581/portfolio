---
import { ClientRouter } from "astro:transitions";
import Aside from "../components/Aside.astro";
import { site } from "../site";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Slug of the open entry, so the index and links row can mark it */
  current?: string;
}

const { title, description = site.tagline, current } = Astro.props;
const fullTitle = title ? `${title} — ${site.title}` : site.title;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <ClientRouter />
  </head>
  <body>
    <!-- Two panes from lg up (index left, page scrolls on the right); one column below,
         where the aside's header, main and index are ordered around each other -->
    <div class="flex min-h-dvh flex-col lg:grid lg:grid-cols-[var(--aside)_minmax(0,1fr)] lg:items-start">
      <Aside current={current} />
      <main class="column order-2 min-w-0 pt-10 pb-16 lg:order-none lg:max-w-none lg:px-14 lg:pb-40">
        <slot />
      </main>
    </div>
  </body>
</html>
