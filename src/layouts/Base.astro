---
import { ClientRouter } from "astro:transitions";
import Aside from "../components/Aside.astro";
import WordCursor from "../components/WordCursor.astro";
import { site } from "../site";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** An entry's own page: full screen and centred, without the header and index */
  full?: boolean;
}

const { title, description = site.tagline, full = false } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, "").replace(/\/index$/, "/"), Astro.site);
---

<!-- Pages swap instantly, without the router's default cross-fade -->
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <ClientRouter />
    <!-- Before first paint, so dark picked with the header toggle doesn't flash light first -->
    <script is:inline>
      const applyTheme = () => {
        try {
          const theme = localStorage.getItem("theme");
          if (theme) document.documentElement.dataset.theme = theme;
        } catch {}
      };
      applyTheme();
      // Page swaps replace <html>'s attributes with the new page's
      document.addEventListener("astro:after-swap", applyTheme);
    </script>
    {/* Cloudflare Web Analytics: cookieless page views, production builds only. The beacon follows
        the router's pushState navigations itself, so it's added once per full page load.
        Visiting any page with ?track=off stops counting this browser; ?track=on resumes it. */}
    {import.meta.env.PROD && (
      <script is:inline>
        (() => {
          if (window.__beacon) return;
          window.__beacon = true;
          let off = false;
          try {
            const track = new URLSearchParams(location.search).get("track");
            if (track === "off") localStorage.setItem("analytics-off", "1");
            if (track === "on") localStorage.removeItem("analytics-off");
            off = localStorage.getItem("analytics-off") === "1";
          } catch {}
          if (off) return;
          const beacon = document.createElement("script");
          beacon.defer = true;
          beacon.src = "https://static.cloudflareinsights.com/beacon.min.js";
          beacon.dataset.cfBeacon = '{"token": "2c1cb33b98eb46a7acb973f8525ddcac"}';
          document.head.append(beacon);
        })();
      </script>
    )}
  </head>
  <body>
    <!-- Home: two panes from lg up (index left, feed scrolls on the right); one column below,
         where the aside's header, main and index are ordered around each other.
         An entry's page: main alone, centred. The aside is still there but hidden (global.css),
         so it persists across pages and the avatar and index don't re-render. -->
    <div class:list={["flex min-h-dvh flex-col", !full && "lg:grid lg:grid-cols-[var(--aside)_minmax(0,1fr)] lg:items-start"]}>
      <Aside />
      {
        full ? (
          <main class="mx-auto w-full max-w-[calc(var(--content)+2*var(--gutter))] px-(--gutter) pt-10 pb-16 lg:pt-16 lg:pb-40" data-full>
            <slot />
          </main>
        ) : (
          <main class="column order-2 min-w-0 pt-10 pb-16 lg:order-none lg:max-w-none lg:px-10 lg:pb-40">
            <slot />
          </main>
        )
      }
    </div>
    <WordCursor />
  </body>
</html>

<script>
  // Clips (see lib/video.mjs) play like GIFs. Offscreen they pause, so a long page doesn't decode
  // every clip at once; with reduced motion they show their first frame and wait for a tap.
  // With a mouse on a wide screen, the cursor over a clip on an entry's page is pause or play
  // (WordCursor), and clicking does that. A clip paused that way stays paused, on screen or off,
  // until it's played again.
  // Same query as the word-cursor variant in global.css
  const wide = matchMedia("(min-width: 1024px) and (hover: hover) and (pointer: fine)");
  const held = new WeakSet<HTMLVideoElement>();

  document.addEventListener("astro:page-load", () => {
    const clips = document.querySelectorAll<HTMLVideoElement>("video[data-clip]");
    if (!clips.length) return;

    if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
      clips.forEach((clip) => {
        clip.autoplay = false;
        clip.pause();
        clip.controls = true;
        // No word over the controls, not even the feed link's open
        clip.closest("[data-cursor]")?.removeAttribute("data-cursor");
      });
      return;
    }

    const onScreen = new IntersectionObserver((entries) => {
      entries.forEach(({ target, isIntersecting }) => {
        const clip = target as HTMLVideoElement;
        if (isIntersecting && !held.has(clip)) clip.play().catch(() => {});
        else clip.pause();
      });
    });
    clips.forEach((clip) => {
      onScreen.observe(clip);
      // On the feed a clip is inside its entry's link, which says open
      if (clip.closest("[data-cursor]")) return;
      const word = () => (clip.dataset.cursor = clip.paused ? "play" : "pause");
      word();
      clip.addEventListener("play", word);
      clip.addEventListener("pause", word);
      clip.addEventListener("click", () => {
        if (!wide.matches) return;
        if (clip.paused) {
          held.delete(clip);
          clip.play().catch(() => {});
        } else {
          held.add(clip);
          clip.pause();
        }
      });
    });
  });
</script>
