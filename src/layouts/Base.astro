---
import { ClientRouter } from "astro:transitions";
import Aside from "../components/Aside.astro";
import { site } from "../site";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Slug of the open entry, so the index and links row can mark it */
  current?: string;
}

const { title, description = site.tagline, current } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : site.name;
---

<!-- Pages swap instantly, without the router's default cross-fade -->
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <ClientRouter />
    <!-- Before first paint, so dark picked with the header toggle doesn't flash light first -->
    <script is:inline>
      const applyTheme = () => {
        try {
          const theme = localStorage.getItem("theme");
          if (theme) document.documentElement.dataset.theme = theme;
        } catch {}
      };
      applyTheme();
      // Page swaps replace <html>'s attributes with the new page's
      document.addEventListener("astro:after-swap", applyTheme);
    </script>
  </head>
  <body>
    <!-- Two panes from lg up (index left, page scrolls on the right); one column below,
         where the aside's header, main and index are ordered around each other -->
    <div class="flex min-h-dvh flex-col lg:grid lg:grid-cols-[var(--aside)_minmax(0,1fr)] lg:items-start">
      <Aside current={current} />
      <main class="column order-2 min-w-0 pt-10 pb-16 lg:order-none lg:max-w-none lg:px-14 lg:pb-40">
        <slot />
      </main>
    </div>
  </body>
</html>

<script>
  // Clips (see lib/video.mjs) play like GIFs. Offscreen they pause, so a long page doesn't decode
  // every clip at once; with reduced motion they show their first frame and wait for a tap.
  document.addEventListener("astro:page-load", () => {
    const clips = document.querySelectorAll<HTMLVideoElement>("video[data-clip]");
    if (!clips.length) return;

    if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
      clips.forEach((clip) => {
        clip.autoplay = false;
        clip.pause();
        clip.controls = true;
      });
      return;
    }

    const onScreen = new IntersectionObserver((entries) => {
      entries.forEach(({ target, isIntersecting }) => {
        const clip = target as HTMLVideoElement;
        if (isIntersecting) clip.play().catch(() => {});
        else clip.pause();
      });
    });
    clips.forEach((clip) => onScreen.observe(clip));
  });
</script>
