---
import { ClientRouter } from "astro:transitions";
import Footer from "../components/Footer.astro";
import { site } from "../site";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Pages that place the footer themselves pass false */
  footer?: boolean;
}

const { title, description = site.tagline, footer = true } = Astro.props;
const fullTitle = title ? `${title} — ${site.title}` : site.title;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <ClientRouter />
  </head>
  <body>
    <slot />
    {footer && <Footer />}
  </body>
</html>

<script>
  import { showPreview } from "../lib/preview";

  // Going home from a project page lands where you left the home page, with that
  // project's preview showing so its image morphs back into place.
  let homeScroll = 0;
  let returningFrom: string | null = null;
  let restoreScroll = false;

  document.addEventListener("astro:before-preparation", (e) => {
    if (e.from.pathname === "/") homeScroll = window.scrollY;
    const slug = e.from.pathname.match(/^\/projects\/([^/]+)/)?.[1];
    returningFrom = slug && e.to.pathname === "/" ? slug : null;
    // Browser back/forward already restores scroll
    restoreScroll = !!returningFrom && e.navigationType !== "traverse";
  });

  // Runs after the new page is in the DOM but before the transition captures it
  document.addEventListener("astro:after-swap", () => {
    if (!returningFrom) return;
    if (restoreScroll) window.scrollTo({ top: homeScroll, behavior: "instant" });
    showPreview(returningFrom);
  });
</script>
