---
import Base from "../layouts/Base.astro";
import Entry from "../components/Entry.astro";
import { anchorOf, getEntries } from "../lib/entries";
// The intro above the feed has its own file, so the about page can say something else
import { Content as Intro } from "../content/intro.md";

// Journal entries live in the index only; the feed is projects
const entries = await getEntries("projects");
---

<Base>
  <h1 class="sr-only">Johnny Dong</h1>
  <div class="prose max-w-(--content)"><Intro /></div>
  <!-- Each block's spacing is padding, not margin, so hovering never falls into a gap between them -->
  <div class="mt-12">
    {
      entries.map((entry) => (
        <div id={anchorOf(entry)} class="pt-12 pb-12 last:pb-0" data-feed={entry.id}>
          <Entry entry={entry} preview />
        </div>
      ))
    }
  </div>
  {/* The space right of the feed goes back to the top, with the cursor turned into the word
      (WordCursor), like an entry's margins go back. From a gap past the feed to the window's edge,
      and at least main's own side padding on narrower screens. Hidden until the page has been
      scrolled a screen down, since at the top there's nowhere to go. Wide screens with a mouse
      only; without scripts it's a plain link to the top. */}
  <a
    href="#"
    class="fixed inset-y-0 right-0 z-10 hidden w-[max(2.5rem,calc(100vw-var(--aside)-2.5rem-var(--content)-3rem))] word-cursor:block"
    tabindex="-1"
    aria-hidden="true"
    data-cursor="top"
    data-to-top
  ></a>
</Base>

<script>
  // The index reads as the feed's table of contents: hovering a project lights up its row, and
  // the row of the project being read is marked as you scroll. On a keyboard, j and k move a
  // project at a time and enter opens the marked one.
  let stop: AbortController | undefined;

  document.addEventListener("astro:page-load", () => {
    stop?.abort();
    // The index persists across pages, so clear marks left from the last visit
    document.querySelectorAll("[data-aside] a[data-slug]").forEach((a) => {
      a.removeAttribute("data-linked");
      a.removeAttribute("aria-current");
    });
    const blocks = [...document.querySelectorAll<HTMLElement>("[data-feed]")];
    if (!blocks.length) return;
    stop = new AbortController();
    const { signal } = stop;
    const row = (block: HTMLElement) =>
      document.querySelector(`[data-aside] a[data-slug="${block.dataset.feed}"]`);

    blocks.forEach((block) => {
      block.addEventListener("mouseenter", () => row(block)?.setAttribute("data-linked", ""), { signal });
      block.addEventListener("mouseleave", () => row(block)?.removeAttribute("data-linked"), { signal });
    });

    // The project being read is the one sitting at the top of the window, where j and k (and the
    // index's links) put it. Otherwise it's the last one whose top has passed a third of the way
    // down, or the last one once the page is scrolled to the end (it may be too short to get
    // there). None while the intro is still on top. The top comes first because a short project
    // put there leaves the next one's top inside that third already.
    const tops = () => blocks.map((b) => b.getBoundingClientRect().top);
    const reading = () => {
      if (innerHeight + scrollY >= document.documentElement.scrollHeight - 2) return blocks.at(-1);
      const at = tops();
      const i = at.findIndex((top) => Math.abs(top) < 1);
      return blocks[i >= 0 ? i : at.findLastIndex((top) => top <= innerHeight / 3)];
    };
    let current: Element | null | undefined;
    const mark = () => {
      const block = reading();
      const next = block && row(block);
      if (next === current) return;
      current?.removeAttribute("aria-current");
      next?.setAttribute("aria-current", "location");
      current = next;
    };
    let queued = false;
    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        mark();
      });
    };
    addEventListener("scroll", onScroll, { passive: true, signal });
    addEventListener("resize", onScroll, { passive: true, signal });
    mark();

    // j brings the next project's top to the top of the window, which marks it; k goes to the
    // one above, or back to the current one's own top when it's been read partway down. Both go
    // by where the projects are rather than by which row is marked, so none is skipped, and k
    // still works at the end of the page, where the last projects can't reach the top. Above the
    // first project is the intro, at the top of the page (-1).
    // While a smooth scroll is on its way, the next j or k counts from where it's headed rather
    // than from wherever it has got to, so pressing twice moves two projects. That's forgotten
    // once the scroll ends, or after a second for browsers without scrollend.
    let headed: number | undefined;
    let forget: number | undefined;
    const settle = () => {
      headed = undefined;
      clearTimeout(forget);
    };
    addEventListener("scrollend", settle, { signal });
    // Scrolling to the block's position rather than following its hash, so the URL stays as it is
    const go = (to: number) => {
      if (to < -1 || to >= blocks.length) return;
      const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const top = to < 0 ? 0 : blocks[to].getBoundingClientRect().top + scrollY;
      scrollTo({ top, behavior: still ? "instant" : "smooth" });
      clearTimeout(forget);
      headed = still ? undefined : to;
      if (headed !== undefined) forget = window.setTimeout(settle, 1000);
    };

    addEventListener(
      "keydown",
      (e) => {
        if (e.defaultPrevented || e.ctrlKey || e.metaKey || e.altKey) return;
        const focus = document.activeElement as HTMLElement | null;
        if (focus?.closest("input, textarea, select") || focus?.isContentEditable) return;

        if (e.key === "j") {
          // None below once the last project's top has passed the top of the window
          const below = tops().findIndex((top) => top >= 1);
          if (headed !== undefined) go(headed + 1);
          else if (below >= 0) go(below);
        } else if (e.key === "k") {
          go(headed !== undefined ? headed - 1 : tops().findLastIndex((top) => top < -8));
        } else if (e.key === "Enter") {
          // Only from the page itself: a focused link or button already does its own thing.
          // Clicking the title lets the router open the page as it would for the mouse.
          if (e.repeat || (focus && focus !== document.body && focus.tagName !== "MAIN")) return;
          const link = reading()?.querySelector<HTMLAnchorElement>("article h2 a");
          if (!link) return;
          link.click();
        } else return;
        e.preventDefault();
      },
      { signal },
    );
  });

  document.addEventListener("astro:before-swap", () => stop?.abort());
</script>

<script>
  // The "top" zone right of the feed (above): shown once the page is a screen down, and a click
  // scrolls back up, smoothly unless motion is reduced
  let stopTop: AbortController | undefined;

  document.addEventListener("astro:page-load", () => {
    stopTop?.abort();
    const zone = document.querySelector<HTMLAnchorElement>("[data-to-top]");
    if (!zone) return;
    stopTop = new AbortController();
    // Inline, since the hidden attribute loses to the zone's display class
    const show = () => (zone.style.display = scrollY < innerHeight ? "none" : "");
    addEventListener("scroll", show, { passive: true, signal: stopTop.signal });
    show();
    zone.addEventListener("click", (e) => {
      e.preventDefault();
      const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
      scrollTo({ top: 0, behavior: still ? "instant" : "smooth" });
    });
  });

  document.addEventListener("astro:before-swap", () => stopTop?.abort());
</script>
