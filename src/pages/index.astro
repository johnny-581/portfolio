---
import Base from "../layouts/Base.astro";
import Sidebar from "../components/Sidebar.astro";
import FeaturedProject from "../components/FeaturedProject.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import Footer from "../components/Footer.astro";
import { getProjects } from "../lib/projects";

const projects = await getProjects();
const featured = projects.find((p) => p.data.featured) ?? projects[0];
const others = projects.filter((p) => p !== featured);
---

<!-- The footer goes in the canvas, beside the sidebar -->
<Base footer={false}>
  <Sidebar />
  <main class="pt-16 lg:ml-(--sidebar) lg:pt-[131px]">
    <FeaturedProject project={featured} />
    <ProjectGrid projects={others} />
    <Footer />
  </main>
</Base>
