---
import { Image } from "astro:assets";
import me from "../assets/me.png";
import { site } from "../site";
---

<header class="text-center">
  <!-- Fixed 620px stage so the words keep their Figma positions; scaled down on phones -->
  <div class="relative left-1/2 h-[416px] w-[620px] -translate-x-1/2 max-sm:-mb-[166px] max-sm:origin-top max-sm:scale-60">
    {
      site.interests.map(({ label, x, y, rotate }) => (
        <span
          class="absolute whitespace-nowrap"
          style={`left: calc(50% + ${x}px); top: ${y}px; transform: translateX(-50%) rotate(${rotate}deg)`}
        >
          {label}
        </span>
      ))
    }
    <Image src={me} alt="Drawing of Johnny" width={154} height={164} densities={[1, 2, 3]} loading="eager" class="absolute top-[252px] left-1/2 -translate-x-1/2" />
  </div>

  <h1 class="mt-[67px] font-serif text-h1 font-bold text-heading max-sm:text-[2.25rem]">{site.name}</h1>
  <p class="mt-[30px] text-h2 max-sm:px-6">{site.tagline}</p>
  <div class="mt-14 flex flex-col gap-[7px]">
    {
      site.roles.map(({ role, at }) => (
        <p>
          {role} <strong>{at}</strong>
        </p>
      ))
    }
  </div>
</header>
