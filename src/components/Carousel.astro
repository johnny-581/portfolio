---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { shotName } from "../lib/shot";

interface Props {
  project: CollectionEntry<"projects">;
}
const { project } = Astro.props;
const { title, images } = project.data;
---

<!-- Starts at the content's left edge and bleeds off the right edge of the screen.
     Slides share one height and keep their own widths; captions wrap to the image. -->
<div class="carousel-root relative" data-carousel-root>
  <div class="carousel no-scrollbar relative flex snap-x snap-proximity gap-[27px] overflow-x-auto" data-carousel>
    {
      images.map((image, i) => (
        <figure class="flex w-min shrink-0 snap-start flex-col gap-5">
          <Image
            src={image.src}
            alt={image.caption ?? `${title} screenshot ${i + 1}`}
            widths={[640, 960, 1400]}
            sizes="(min-width: 1024px) 700px, 80vw"
            loading={i === 0 ? "eager" : "lazy"}
            class="h-(--slide-h) w-auto max-w-none rounded-[4px] object-cover"
            transition:name={i === 0 ? shotName(project.id) : undefined}
          />
          {image.caption && <figcaption>{image.caption}</figcaption>}
        </figure>
      ))
    }
  </div>

  {
    images.length > 1 && (
      <>
        <button type="button" class="arrow left-1 lg:left-0" aria-label="Previous image" data-step="-1">
          <img src="/icons/chevron-left.svg" alt="" width="24" height="24" />
        </button>
        <button type="button" class="arrow right-1 lg:right-auto lg:left-[min(987px,100%_-_54px)]" aria-label="Next image" data-step="1">
          <img src="/icons/chevron-right.svg" alt="" width="24" height="24" />
        </button>
      </>
    )
  }
</div>

<style>
  .carousel-root {
    --slide-h: clamp(200px, 40vw, 394px);
  }
  /* Inset to the content column's left edge: page gutter on small screens, 60px into the canvas from lg */
  .carousel {
    padding-inline: var(--gutter);
    scroll-padding-inline: var(--gutter);
  }
  @media (width >= 64rem) {
    .carousel {
      padding-left: 60px;
      scroll-padding-left: 60px;
    }
  }
  /* Centered on the images; hidden when there's nothing further that way */
  .arrow {
    position: absolute;
    top: calc(var(--slide-h) / 2 - 15px);
    border-radius: 9999px;
    background: var(--color-neutral-100);
    padding: 3px;
    filter: drop-shadow(0 0 2px rgb(0 0 0 / 0.25));
    transition: opacity 150ms;
  }
  .arrow.off {
    opacity: 0;
    pointer-events: none;
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLElement>("[data-carousel-root]").forEach((root) => {
      const track = root.querySelector<HTMLElement>("[data-carousel]")!;
      const slides = [...track.querySelectorAll<HTMLElement>("figure")];
      const arrows = [...root.querySelectorAll<HTMLButtonElement>("[data-step]")];
      const inset = () => parseFloat(getComputedStyle(track).scrollPaddingLeft) || 0;

      const scrollToSlide = (slide: HTMLElement) =>
        track.scrollTo({ left: slide.offsetLeft - inset(), behavior: "smooth" });

      // The slide at the start of the view
      const currentIndex = () => {
        const x = track.scrollLeft + inset();
        return slides.reduce((best, s, i) => (Math.abs(s.offsetLeft - x) < Math.abs(slides[best].offsetLeft - x) ? i : best), 0);
      };

      const update = () => {
        const max = track.scrollWidth - track.clientWidth;
        for (const arrow of arrows) {
          const off = arrow.dataset.step === "-1" ? track.scrollLeft <= 1 : track.scrollLeft >= max - 1;
          arrow.classList.toggle("off", off);
          arrow.tabIndex = off ? -1 : 0;
        }
      };

      arrows.forEach((arrow) =>
        arrow.addEventListener("click", () => {
          const i = Math.min(slides.length - 1, Math.max(0, currentIndex() + Number(arrow.dataset.step)));
          scrollToSlide(slides[i]);
        }),
      );
      // Clicking a peeking slide scrolls it into view
      slides.forEach((slide) => slide.addEventListener("click", () => scrollToSlide(slide)));

      track.addEventListener("scroll", update, { passive: true });
      window.addEventListener("resize", update);
      document.addEventListener("astro:before-swap", () => window.removeEventListener("resize", update), { once: true });
      update();
    });
  });
</script>
