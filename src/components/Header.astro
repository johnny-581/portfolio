---
import Avatar from "./Avatar.astro";
import { site } from "../site";

// The header shows on home and on pages like about; the one you're on is the marked link. The
// aside persists across page swaps without re-rendering, so the script below moves the mark too.
// The site's own links (github, linkedin, email, resume) lead off the site, so they get an arrow,
// like an entry's links
const here = Astro.url.pathname.replace(/\/$/, "") || "/";
const links = [
  { label: "home", href: "/" },
  { label: "about", href: "/about" },
  ...site.links.map((link) => ({ ...link, away: true })),
];
---

<!-- The avatar sits in the top-left corner with the name beside it, bottom-aligned to its chin -->
<header class="grid grid-cols-[116px_1fr] items-end gap-x-4 sm:gap-x-5">
  <Avatar />
  <div class="min-w-0 pb-2.5">
    <a
      href="/"
      class="mb-1.5 inline-block font-serif text-name font-bold text-ink hover:underline hover:decoration-1 hover:underline-offset-4"
    >
      {site.name.toLowerCase()}
    </a>
    <p class="text-ui text-ink-soft">{site.role}</p>
    <p class="flex gap-x-[0.6em] text-ui whitespace-nowrap text-muted">
      {
        site.places.map(({ label, href }) =>
          href ? (
            <a
              href={href}
              target="_blank"
              rel="noopener"
              class="hover:text-ink hover:underline hover:decoration-1 hover:underline-offset-[3px]"
            >
              {label}
            </a>
          ) : (
            <span>{label}</span>
          ),
        )
      }
    </p>
  </div>

  <!-- One row that wraps wherever it runs out of room, never between a link and its arrow -->
  <nav aria-label="elsewhere" class="col-span-full mt-[18px] flex flex-wrap gap-x-[0.6em] text-ui text-ink">
    {
      links.map((link) => (
        <a
          href={link.href}
          aria-current={link.href === here ? "page" : undefined}
          data-nav-link
          target={link.href.startsWith("http") ? "_blank" : undefined}
          rel={link.href.startsWith("http") ? "noopener" : undefined}
          class="whitespace-nowrap hover:underline hover:decoration-1 hover:underline-offset-[3px] aria-[current=page]:underline aria-[current=page]:decoration-1 aria-[current=page]:underline-offset-[3px]"
        >
          {"away" in link ? `${link.label} ↗` : link.label}
        </a>
      ))
    }
  </nav>

  <!-- In the page's top-right corner: the moon in light, the sun in dark, so it shows the theme it
       switches to. The drawings are masks filled with the text colour, so they follow the theme.
       Below lg the aside has no box, so this sits at the top of the page and scrolls away; from lg
       up the aside is sticky, so it's fixed to the window instead. It and the aside sit above
       home's back-to-top strip down the right edge (index.astro), so the icon gets the click and a
       hand cursor rather than the word "top" -->
  <button
    type="button"
    data-theme-toggle
    aria-label="Switch theme"
    class="absolute top-6 right-(--gutter) z-20 grid size-9 cursor-pointer place-items-center text-ink opacity-80 hover:opacity-100 lg:fixed lg:top-7 lg:right-8"
  >
    <span
      aria-hidden="true"
      class="block size-5 bg-current [mask:url(/icons/moon.png)_center/contain_no-repeat] [[data-theme=dark]_&]:hidden"
    ></span>
    <span
      aria-hidden="true"
      class="hidden size-6 bg-current [mask:url(/icons/sun.png)_center/contain_no-repeat] [[data-theme=dark]_&]:block"
    ></span>
  </button>
</header>

<script>
  // The aside persists across page swaps, so mark the link of the page now showing
  document.addEventListener("astro:page-load", () => {
    const here = location.pathname.replace(/\/$/, "") || "/";
    document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]").forEach((link) => {
      if (link.getAttribute("href") === here) link.setAttribute("aria-current", "page");
      else link.removeAttribute("aria-current");
    });
  });

  // Light until clicked; the choice is saved and Base applies it on load
  document.addEventListener("astro:page-load", () => {
    const toggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
    // The header persists across pages (hidden on entry pages), so bind once
    if (!toggle || toggle.dataset.bound) return;
    toggle.dataset.bound = "1";

    const root = document.documentElement;
    const isDark = () => root.dataset.theme === "dark";
    // The icon follows data-theme in CSS; only the label needs setting
    const label = () => {
      toggle.setAttribute("aria-label", `Switch to ${isDark() ? "light" : "dark"} theme`);
    };

    toggle.addEventListener("click", () => {
      const theme = isDark() ? "light" : "dark";
      root.dataset.theme = theme;
      try {
        localStorage.setItem("theme", theme);
      } catch {}
      label();
    });
    label();
  });
</script>
