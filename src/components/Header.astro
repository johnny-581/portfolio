---
import Avatar from "./Avatar.astro";
import { site } from "../site";

interface Props {
  /** Slug of the open page, so its link in the row is marked */
  current?: string;
}

const { current } = Astro.props;
const links = [{ label: "about", href: "/about", slug: "about" }, ...site.links];
---

<!-- The avatar sits in the top-left corner with the name beside it, bottom-aligned to its chin -->
<header class="grid grid-cols-[116px_1fr] items-end gap-x-4 sm:gap-x-5">
  <Avatar />
  <div class="min-w-0 pb-2.5">
    <a
      href="/"
      class="mb-1.5 inline-block font-serif text-name font-bold text-ink hover:underline hover:decoration-1 hover:underline-offset-4"
    >
      {site.name.toLowerCase()}
    </a>
    <p class="text-ui text-ink-soft">{site.role}</p>
    <p class="flex gap-x-[0.6em] text-ui whitespace-nowrap text-muted">
      {
        site.places.map(({ label, href }) =>
          href ? (
            <a
              href={href}
              target="_blank"
              rel="noopener"
              class="hover:text-ink hover:underline hover:decoration-1 hover:underline-offset-[3px]"
            >
              {label}
            </a>
          ) : (
            <span>{label}</span>
          ),
        )
      }
    </p>
  </div>

  <nav aria-label="elsewhere" class="col-span-full mt-[18px] flex flex-wrap gap-x-[0.75em] text-ui text-ink">
    {
      links.map((link) => (
        <>
          <a
            href={link.href}
            aria-current={"slug" in link && link.slug === current ? "page" : undefined}
            data-slug={"slug" in link ? link.slug : undefined}
            target={link.href.startsWith("http") ? "_blank" : undefined}
            rel={link.href.startsWith("http") ? "noopener" : undefined}
            class="hover:underline hover:decoration-1 hover:underline-offset-[3px] aria-[current=page]:underline aria-[current=page]:decoration-1 aria-[current=page]:underline-offset-[3px]"
          >
            {link.label}
          </a>
        </>
      ))
    }
    <!-- Names the theme it switches to; the script fills it in once the current theme is known -->
    <button
      type="button"
      data-theme-toggle
      class="min-w-[2.5em] cursor-pointer text-left hover:underline hover:decoration-1 hover:underline-offset-[3px]"
    ></button>
  </nav>
</header>

<script>
  // Light until clicked; the choice is saved and Base applies it on load
  document.addEventListener("astro:page-load", () => {
    const toggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
    // The header persists across pages, so bind once
    if (!toggle || toggle.dataset.bound) return;
    toggle.dataset.bound = "1";

    const root = document.documentElement;
    const isDark = () => root.dataset.theme === "dark";
    const label = () => {
      const next = isDark() ? "light" : "dark";
      toggle.textContent = next;
      toggle.setAttribute("aria-label", `Switch to ${next} theme`);
    };

    toggle.addEventListener("click", () => {
      const theme = isDark() ? "light" : "dark";
      root.dataset.theme = theme;
      try {
        localStorage.setItem("theme", theme);
      } catch {}
      label();
    });
    label();
  });
</script>
