---
import { anchorOf, titleOf, type Entry } from "../lib/entries";

interface Props {
  /** The section's name, shown above its rows */
  label: string;
  entries: Entry[];
}

const { label, entries } = Astro.props;
---

<nav aria-label={label}>
  <div class="mb-2 flex justify-between font-mono text-meta text-muted">
    <span>{label}</span>
    <span>{entries.length}</span>
  </div>
  <ol>
    {
      entries.map((entry) => {
        // Projects scroll the home feed to their entry; journal entries aren't in it, so they open
        const anchor = anchorOf(entry);
        return (
          <li>
            {/* Title with its tag after a slash, then the date at the right edge, without the
                trailing dash of one still going ("2026-"). A highlighted row darkens its title
                and date; the tag stays faint */}
            <a
              href={anchor ? `/#${anchor}` : `/${entry.id}`}
              data-slug={entry.id}
              class="group flex items-baseline justify-between gap-x-3 py-0.5 text-ui text-muted"
            >
              <span class="min-w-0">
                <span class="transition-colors duration-120 group-hover:text-ink group-focus-visible:text-ink group-data-linked:text-ink group-aria-[current=location]:text-ink motion-reduce:transition-none">
                  {titleOf(entry)}
                </span>
                {entry.data.tag && <span class="text-faint"> / {entry.data.tag}</span>}
              </span>
              <span class="shrink-0 tabular-nums transition-colors duration-120 group-hover:text-ink group-focus-visible:text-ink group-data-linked:text-ink group-aria-[current=location]:text-ink motion-reduce:transition-none">
                {entry.data.when?.replace(/[-–—]+$/, "")}
              </span>
            </a>
          </li>
        );
      })
    }
  </ol>
</nav>
