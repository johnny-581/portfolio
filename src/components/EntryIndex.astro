---
import { titleOf, type Entry } from "../lib/entries";

interface Props {
  /** The section's name, shown above its rows */
  label: string;
  entries: Entry[];
  /** Path of the open entry; none on the home page */
  current?: string;
}

const { label, entries, current } = Astro.props;
---

<nav aria-label={label}>
  <div class="mb-2 flex justify-between font-mono text-meta text-muted">
    <span>{label}</span>
    <span>{entries.length}</span>
  </div>
  <ol>
    {
      entries.map((entry) => (
        <li>
          {/* The tag column is fixed, so dates line up across sections; it fits "hackathon" */}
          <a
            href={`/${entry.id}`}
            data-slug={entry.id}
            aria-current={entry.id === current ? "page" : undefined}
            class="group grid grid-cols-[minmax(0,1fr)_60px_72px] items-baseline gap-x-3 py-0.5 text-muted"
          >
            <span class="text-ui transition-colors duration-120 group-hover:text-ink group-focus-visible:text-ink group-data-linked:text-ink group-aria-[current=page]:font-medium group-aria-[current=page]:text-ink motion-reduce:transition-none">
              {titleOf(entry)}
            </span>
            <span class="font-mono text-meta">{entry.data.when}</span>
            <span class="font-mono text-meta">{entry.data.tag}</span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>
