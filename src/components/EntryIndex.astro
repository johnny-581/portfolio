---
import type { Entry } from "../lib/entries";

interface Props {
  entries: Entry[];
  /** Slug of the open entry; none on the home page */
  current?: string;
}

const { entries, current } = Astro.props;
---

<nav aria-label="index">
  <div class="mb-2 flex justify-between font-mono text-meta text-muted">
    <span>index</span>
    <span>{entries.length}</span>
  </div>
  <ol>
    {
      entries.map((entry) => (
        <li>
          <a
            href={`/${entry.id}`}
            data-slug={entry.id}
            aria-current={entry.id === current ? "page" : undefined}
            class="group grid grid-cols-[minmax(0,1fr)_56px_56px] items-baseline gap-x-3 py-0.5 text-muted"
          >
            <span class="truncate text-ui transition-colors duration-120 group-hover:text-ink group-focus-visible:text-ink group-aria-[current=page]:font-medium group-aria-[current=page]:text-ink motion-reduce:transition-none">
              {entry.data.title}
            </span>
            <span class="font-mono text-meta">{entry.data.when}</span>
            <span class="font-mono text-meta">{entry.data.tag}</span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>
