---
const links = [
  { label: "home", href: "/" },
  { label: "about me", href: "/about" },
];
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<!-- Same spot as "back to home" on project pages -->
<nav class="absolute top-[94px] left-[62px] hidden flex-col gap-5 lg:flex">
  {
    links.map(({ label, href }) => {
      const active = path === href;
      return (
        <a href={href} class:list={[active ? "font-bold" : "hover:text-muted"]} aria-current={active ? "page" : undefined}>
          {label}
        </a>
      );
    })
  }
</nav>
