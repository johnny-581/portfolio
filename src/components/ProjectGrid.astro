---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import ProjectTitle from "./ProjectTitle.astro";

interface Props {
  projects: CollectionEntry<"projects">[];
}
const { projects } = Astro.props;

// Three staggered columns, filled left to right; the preview ends the last column
const columns: (typeof projects)[] = [[], [], []];
projects.forEach((project, i) => columns[i % 3].push(project));
---

<section class="container-projects mt-[98px] grid gap-y-10 md:grid-cols-3 md:gap-x-7" data-project-grid>
  {
    columns.map((column, i) => (
      <div class="flex flex-col gap-12 max-md:contents">
        {column.map((project) => (
          <a
            href={`/projects/${project.id}`}
            class="flex flex-col gap-4 max-md:order-(--order)"
            style={`--order: ${projects.indexOf(project)}`}
            data-slug={project.id}
          >
            <ProjectTitle title={project.data.title} status={project.data.status} />
            <p>{project.data.blurb}</p>
          </a>
        ))}

        {i === 2 && (
          <div class="preview relative aspect-[434/271] max-md:hidden pointer-coarse:hidden" aria-hidden="true">
            {projects.map((project) => (
              <Image
                src={project.data.images[0].src}
                alt=""
                widths={[434, 868]}
                sizes="434px"
                loading="eager"
                class="absolute inset-0 size-full rounded-[4px] object-cover opacity-0"
                data-preview={project.id}
              />
            ))}
          </div>
        )}
      </div>
    ))
  }
</section>

<style>
  /* 434px wide, sticking out past the grid's right edge, but never past the page gutter.
     Here 100% is the column width and 100cqw is <main>'s width. */
  .preview {
    width: min(434px, 100% + (100cqw - 3 * 100% - 56px) / 2 - var(--gutter));
  }
</style>

<script>
  import { shotName } from "../lib/shot";

  document.addEventListener("astro:page-load", () => {
    const grid = document.querySelector<HTMLElement>("[data-project-grid]");
    if (!grid) return;

    // A preview may already be showing when returning from a project page
    let active = grid.querySelector<HTMLElement>("[data-preview]:not(.opacity-0)");
    let scrolling = false;
    let scrollTimer: number | undefined;

    const show = (slug: string | null) => {
      if (active) {
        active.classList.add("opacity-0");
        active.style.viewTransitionName = "";
      }
      active = slug ? grid.querySelector<HTMLElement>(`[data-preview="${slug}"]`) : null;
      if (active) {
        active.classList.remove("opacity-0");
        active.style.viewTransitionName = shotName(slug!);
      }
    };

    grid.querySelectorAll<HTMLElement>("[data-slug]").forEach((card) => {
      const onEnter = () => !scrolling && show(card.dataset.slug!);
      card.addEventListener("pointerenter", onEnter);
      card.addEventListener("focus", onEnter);
    });

    // Hide on the first scroll tick, and ignore the hover events the browser
    // fires while content moves under a still cursor. Events that don't move the
    // page (like the one from restoring the scroll position) are skipped.
    let lastY = window.scrollY;
    const onScroll = () => {
      if (window.scrollY === lastY) return;
      lastY = window.scrollY;
      show(null);
      scrolling = true;
      clearTimeout(scrollTimer);
      scrollTimer = window.setTimeout(() => (scrolling = false), 150);
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    document.addEventListener("astro:before-swap", () => window.removeEventListener("scroll", onScroll), { once: true });
  });
</script>
