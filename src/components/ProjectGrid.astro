---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import ProjectTitle from "./ProjectTitle.astro";

interface Props {
  projects: CollectionEntry<"projects">[];
}
const { projects } = Astro.props;

// Each project names its column; any without one fill the columns in turn
const columns: (typeof projects)[] = [[], [], []];
projects.forEach((project, i) => columns[(project.data.column ?? (i % 3) + 1) - 1].push(project));
---

<section class="container-canvas mt-16 lg:mt-[88px]">
  <div class="grid gap-x-7 gap-y-10 md:grid-cols-2 lg:ml-[clamp(0px,4vw,61px)] lg:max-w-[904px] lg:grid-cols-[280fr_284fr_284fr]" data-project-grid>
    {
      columns.map((column, i) => (
        <div class="flex flex-col gap-9 max-lg:contents">
          {column.map((project) => (
            <a
              href={`/projects/${project.id}`}
              class="flex flex-col gap-4 max-lg:order-(--order)"
              style={`--order: ${project.data.order}`}
              data-card
              data-slug={project.id}
              data-column={i + 1}
            >
              <ProjectTitle title={project.data.title} status={project.data.status} />
              <p>{project.data.blurb}</p>
            </a>
          ))}
        </div>
      ))
    }
  </div>
</section>

<!-- Hover thumbnails, positioned by lib/preview.ts. Desktop with a mouse only. -->
<div class="pointer-events-none fixed inset-0 z-10 max-lg:hidden pointer-coarse:hidden" aria-hidden="true" data-thumbs>
  {
    projects.map((project) => (
      <Image
        src={project.data.images[0].src}
        alt=""
        widths={[392, 784]}
        sizes="392px"
        loading="eager"
        class="absolute top-0 left-0 rounded-[4px] object-cover opacity-0"
        data-preview={project.id}
      />
    ))
  }
</div>

<script>
  import { showPreview } from "../lib/preview";

  document.addEventListener("astro:page-load", () => {
    const grid = document.querySelector<HTMLElement>("[data-project-grid]");
    if (!grid) return;

    let scrolling = false;
    let scrollTimer: number | undefined;

    grid.querySelectorAll<HTMLElement>("[data-card]").forEach((card) => {
      const onEnter = () => !scrolling && showPreview(card.dataset.slug!);
      const onLeave = () => showPreview(null);
      card.addEventListener("pointerenter", onEnter);
      card.addEventListener("focus", onEnter);
      card.addEventListener("pointerleave", onLeave);
      card.addEventListener("blur", onLeave);
    });

    // Hide on the first scroll tick, and ignore the hover events the browser
    // fires while content moves under a still cursor. Events that don't move the
    // page (like the one from restoring the scroll position) are skipped.
    let lastY = window.scrollY;
    const onScroll = () => {
      if (window.scrollY === lastY) return;
      lastY = window.scrollY;
      showPreview(null);
      scrolling = true;
      clearTimeout(scrollTimer);
      scrollTimer = window.setTimeout(() => (scrolling = false), 150);
    };
    const onResize = () => showPreview(null);
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onResize);
    document.addEventListener(
      "astro:before-swap",
      () => {
        window.removeEventListener("scroll", onScroll);
        window.removeEventListener("resize", onResize);
      },
      { once: true },
    );
  });
</script>
