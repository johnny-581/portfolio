---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import ProjectTitle from "./ProjectTitle.astro";
import { shotName } from "../lib/shot";

interface Props {
  projects: CollectionEntry<"projects">[];
}
const { projects } = Astro.props;

// Projects alternate between the two columns, so they read left to right, row by row
const columns: (typeof projects)[] = [[], []];
projects.forEach((project, i) => columns[i % 2].push(project));
---

<!-- Two staggered columns of image cards, lining up with the featured project's edges.
     A single column on small screens, in the projects' order. -->
<section class="container-canvas mt-16 lg:mt-[100px]">
  <div class="grid gap-x-7 gap-y-12 md:grid-cols-2 lg:max-w-[750px]">
    {
      columns.map((column) => (
        <div class="flex flex-col gap-12 max-md:contents">
          {column.map((project) => (
            <a
              href={`/projects/${project.id}`}
              class="group flex flex-col gap-4 max-md:order-(--order)"
              style={`--order: ${project.data.order}`}
            >
              <Image
                src={project.data.images[0].src}
                alt={`${project.data.title} screenshot`}
                widths={[400, 720, 1080]}
                sizes="(min-width: 1024px) 361px, (min-width: 768px) calc(50vw - 38px), calc(100vw - 48px)"
                class="h-auto w-full rounded-[4px] bg-neutral-100 transition-opacity group-hover:opacity-85"
                transition:name={shotName(project.id)}
              />
              <ProjectTitle title={project.data.title} status={project.data.status} />
            </a>
          ))}
        </div>
      ))
    }
  </div>
</section>
