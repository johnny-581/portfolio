---
import { site } from "../site";
---

<footer class="mt-[195px] bg-neutral-100">
  <div class="flex flex-col gap-10 px-6 py-[55px] md:grid md:grid-cols-[minmax(0,698px)_auto] lg:px-[63px]">
    <ul class="flex flex-col gap-[11px]">
      {
        site.social.map((link) => (
          <li>
            <a href={link.href} class="hover:text-muted">{link.label}</a>
          </li>
        ))
      }
    </ul>
    <p>{site.footerNote}</p>
  </div>
</footer>
