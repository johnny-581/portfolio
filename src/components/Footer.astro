---
import { site } from "../site";
---

<footer class="mt-[195px] bg-neutral-100 px-6 py-[55px] lg:px-[60px]">
  <!-- 900px wide from lg up, so the note lines up with the right edge of the home page content -->
  <div class="flex flex-col gap-10 md:flex-row md:justify-between lg:max-w-[900px]">
    <ul class="flex flex-col gap-[11px]">
      {
        site.social.map((link) => (
          <li>
            <a href={link.href} class="hover:text-muted">{link.label}</a>
          </li>
        ))
      }
    </ul>
    <p>{site.footerNote}</p>
  </div>
</footer>
