---
import { Image } from "astro:assets";
import opened from "../assets/opened.png";
import half from "../assets/half.png";
import closed from "../assets/closed.png";

// Blink frames, stacked; the wrapper's data-frame says which one shows
const frames = [
  { name: "open", src: opened },
  { name: "half", src: half },
  { name: "closed", src: closed },
];
---

<!-- Blinks every few seconds on its own, and when the cursor enters it or the header around it, or clicks it; when a finger taps
     or swipes across it; or when it scrolls back into view -->
<div class="avatar relative h-[123px] w-[116px]" data-avatar data-frame="open">
  {
    frames.map(({ name, src }) => (
      <Image
        src={src}
        alt={name === "open" ? "Drawing of Johnny" : ""}
        aria-hidden={name === "open" ? undefined : "true"}
        width={116}
        height={123}
        densities={[1, 2, 3]}
        loading="eager"
        class="absolute inset-0"
        data-name={name}
      />
    ))
  }
</div>

<style>
  /* Frames swap instantly; a cross-fade would read as ghosting, not blinking */
  .avatar :global(img) {
    visibility: hidden;
  }
  .avatar[data-frame="open"] :global([data-name="open"]),
  .avatar[data-frame="half"] :global([data-name="half"]),
  .avatar[data-frame="closed"] :global([data-name="closed"]) {
    visibility: visible;
  }

  /* The frames are dark strokes on a transparent background, so flip them in dark mode */
  .avatar :global(img) {
    filter: invert(var(--dark)) hue-rotate(calc(180deg * var(--dark)));
  }
</style>

<script>
  // Real eyelids snap shut and open more slowly, so the half frame only shows on the way up
  const CLOSED_MS = 80;
  const HALF_MS = 70;
  // Rest after a blink, so wiggling over it doesn't flicker
  const REST_MS = 400;

  document.addEventListener("astro:page-load", () => {
    const avatar = document.querySelector<HTMLElement>("[data-avatar]");
    // The avatar persists across pages, so bind it once for the whole session
    if (!avatar || avatar.dataset.bound) return;
    avatar.dataset.bound = "1";

    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
    let blinkingUntil = 0;
    let restingUntil = 0;

    const later = (ms: number, fn: () => void) => window.setTimeout(fn, ms);
    // A click skips the rest, so clicking right after the hover blink still blinks
    const blink = (afterRest = true) => {
      const now = performance.now();
      if (reducedMotion.matches || now < blinkingUntil || (afterRest && now < restingUntil)) return;
      blinkingUntil = now + CLOSED_MS + HALF_MS;
      restingUntil = blinkingUntil + REST_MS;
      avatar.dataset.frame = "closed";
      later(CLOSED_MS, () => (avatar.dataset.frame = "half"));
      later(CLOSED_MS + HALF_MS, () => (avatar.dataset.frame = "open"));
      idle();
    };

    // On its own, every 2–7 s like a person at rest; any blink restarts the wait
    let idleTimer = 0;
    const idle = () => {
      window.clearTimeout(idleTimer);
      idleTimer = later(2000 + Math.random() * 5000, () => (document.hidden ? idle() : blink()));
    };
    idle();

    // Mouse and pen, on the way in and on each click; touch is handled below. Entering the
    // header counts too, as if the face noticed you reaching for its links
    const enter = (e: PointerEvent) => e.pointerType !== "touch" && blink();
    avatar.closest("header")?.addEventListener("pointerenter", enter);
    avatar.addEventListener("pointerenter", enter);
    avatar.addEventListener("pointerdown", (e) => e.pointerType !== "touch" && blink(false));

    // Coming back into view after being scrolled away, so people who never hover it still see
    // it blink. Only the one-column layout scrolls it away; beside the page it never leaves
    // the screen, so this never fires there. Once per trip, after any momentum or bounce settles
    const SETTLE_MS = 350;
    let armed = false;
    let settle = 0;
    window.addEventListener(
      "scroll",
      () => {
        window.clearTimeout(settle);
        const { top, bottom, width } = avatar.getBoundingClientRect();
        // Zero-size when the header is hidden (project and journal pages in one column)
        if (!width) return;
        if (bottom <= 0) armed = true;
        else if (armed && top >= 0) {
          settle = later(SETTLE_MS, () => {
            armed = false;
            blink();
          });
        }
      },
      { passive: true },
    );
    // A new page starts at the top without the trip back
    document.addEventListener("astro:after-swap", () => {
      window.clearTimeout(settle);
      armed = false;
    });

    // A touch only reports to the element it started on, so follow the finger across the
    // page and blink when it moves onto the avatar (or starts there)
    let fingerOver = false;
    const onTouch = (e: TouchEvent) => {
      const touch = e.touches[0];
      if (!touch) return;
      const r = avatar.getBoundingClientRect();
      const over = r.width > 0 && touch.clientX >= r.left && touch.clientX <= r.right && touch.clientY >= r.top && touch.clientY <= r.bottom;
      if (over && !fingerOver) blink();
      fingerOver = over;
    };
    const onTouchEnd = () => (fingerOver = false);

    // Never removed: the avatar lives for the whole session
    document.addEventListener("touchstart", onTouch, { passive: true });
    document.addEventListener("touchmove", onTouch, { passive: true });
    document.addEventListener("touchend", onTouchEnd);
    document.addEventListener("touchcancel", onTouchEnd);
  });
</script>
