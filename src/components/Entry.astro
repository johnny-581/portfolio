---
import { Image } from "astro:assets";
import { render } from "astro:content";
import { firstImage, type Entry } from "../lib/entries";

interface Props {
  entry: Entry;
  /** On the home feed: the summary and first image instead of the body, linking to the entry's page */
  preview?: boolean;
}

const { entry, preview = false } = Astro.props;
const { title, tag, when, links, summary } = entry.data;
const { Content } = await render(entry);
const image = preview ? firstImage(entry) : undefined;

// The feed has many entries, so only a lone entry gets the page's h1
const Heading = preview ? "h2" : "h1";
---

<article class="max-w-[620px]">
  <Heading class="font-serif text-[1.875rem]/[2.25rem] font-bold tracking-[-0.01em] text-ink sm:text-title">
    {
      preview ? (
        <a href={`/${entry.id}`} class="hover:underline hover:decoration-1 hover:underline-offset-[5px]">
          {title}
        </a>
      ) : (
        title
      )
    }
  </Heading>
  <p class="mt-1.5 flex flex-wrap gap-x-[1em] font-mono text-meta text-muted">
    <span>{tag}</span><span>{when}</span>
    {
      links.map((link) => (
        <>
          <a
            href={link.href}
            target={link.href.startsWith("http") ? "_blank" : undefined}
            rel={link.href.startsWith("http") ? "noopener" : undefined}
            class="text-ink-soft hover:underline hover:underline-offset-[3px]"
          >
            {link.label} ↗
          </a>
        </>
      ))
    }
  </p>
  <div class="prose mt-7">
    {
      preview ? (
        <>
          <p>{summary}</p>
          {image && (
            <a href={`/${entry.id}`} class="mt-6 block" tabindex="-1" aria-hidden="true">
              <Image src={image.src} alt={image.alt} widths={[620, 1240]} sizes="(min-width: 1024px) 620px, 100vw" />
            </a>
          )}
        </>
      ) : (
        <Content />
      )
    }
  </div>
</article>
