---
import { Image } from "astro:assets";
import { render } from "astro:content";
import { anchorOf, firstMedia, titleOf, type Entry } from "../lib/entries";
import { videoHtml } from "../lib/video.mjs";

interface Props {
  entry: Entry;
  /** On the home feed: the summary and first image or clip instead of the body, linking to the entry's page */
  preview?: boolean;
}

const { entry, preview = false } = Astro.props;
const { links, summary } = entry.data;
const title = titleOf(entry);
const { Content } = await render(entry);
const media = preview ? firstMedia(entry) : undefined;

// An entry's own page has no header or index, just a link back: to the project's place in the
// feed, or the top of home for entries the feed doesn't show (journal, about)
const anchor = anchorOf(entry);
const back = anchor ? `/#${anchor}` : "/";

// The feed has many entries, so only a lone entry gets the page's h1
const Heading = preview ? "h2" : "h1";
---

<article class="max-w-(--content)">
  {
    !preview && (
      <>
        <a href={back} class="mb-8 block w-fit text-ui text-ink underline decoration-1 underline-offset-[3px]" data-back>
          back
        </a>
        {/* The side margins work as back too, with the cursor turned into the word (WordCursor).
            Wide screens with a mouse only; the link above is the one for keyboards and readers */}
        {["left-0", "right-0"].map((side) => (
          <a
            href={back}
            class:list={["fixed inset-y-0 z-10 hidden w-[max(0px,calc(50vw-var(--content)/2-3rem))] word-cursor:block", side]}
            tabindex="-1"
            aria-hidden="true"
            data-back
            data-cursor="back"
          />
        ))}
      </>
    )
  }
  <Heading class="font-serif text-[1.875rem]/[2.25rem] font-bold tracking-[-0.01em] text-ink sm:text-title">
    {
      preview ? (
        <a href={`/${entry.id}`} class="hover:underline hover:decoration-1 hover:underline-offset-[5px]">
          {title}
        </a>
      ) : (
        title
      )
    }
  </Heading>
  {
    // Only the entry's own page lists its links; the index already shows tag and years
    !preview && links.length > 0 && (
      <p class="mt-[22px] flex flex-wrap gap-x-[1em] text-ui">
        {links.map((link) => (
          <a
            href={link.href}
            target={link.href.startsWith("http") ? "_blank" : undefined}
            rel={link.href.startsWith("http") ? "noopener" : undefined}
            class="text-ink-soft underline decoration-faint decoration-1 underline-offset-[3px] hover:text-ink hover:decoration-ink"
          >
            {link.label} ↗
          </a>
        ))}
      </p>
    )
  }
  <div class:list={["prose", preview ? "mt-4" : links.length ? "mt-[18px]" : "mt-7"]}>
    {
      preview ? (
        <>
          <p>{summary}</p>
          {media && (
            <a href={`/${entry.id}`} class="mt-6 block" tabindex="-1" aria-hidden="true" data-cursor="open">
              {media.kind === "video" ? (
                <Fragment set:html={videoHtml(media.src, media.alt)} />
              ) : (
                <Image src={media.src} alt={media.alt} widths={[780, 1560]} sizes="(min-width: 1024px) 780px, 100vw" />
              )}
            </a>
          )}
        </>
      ) : (
        <Content />
      )
    }
  </div>
  {
    // An end mark under an entry's own page, so the last line reads as the end: three drawn stars,
    // a mask filled with the muted text colour so it follows the theme
    !preview && (
      <div
        class="mx-auto mt-14 aspect-[1457/298] h-4 bg-muted [mask:url(/icons/stars.png)_center/contain_no-repeat]"
        aria-hidden="true"
      />
    )
  }
</article>

<script>
  // Back from an entry opened from the feed goes back in history, so home comes back at the
  // exact scroll position it was left at (the router restores it). Opened any other way (a shared
  // link, a link from another page), back is a plain link to the project's place in the feed.
  let fromHome = false;
  document.addEventListener("astro:before-preparation", (e) => {
    fromHome = e.from.pathname === "/" && e.navigationType === "push";
  });

  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLAnchorElement>("a[data-back]").forEach((link) => {
      // On the link itself, so it runs before the router's handler on document, which then
      // leaves the click alone
      link.addEventListener("click", (e) => {
        if (!fromHome || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        e.preventDefault();
        history.back();
      });
    });
  });
</script>
