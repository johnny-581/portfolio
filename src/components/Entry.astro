---
import { Image } from "astro:assets";
import { render } from "astro:content";
import { firstMedia, sectionOf, titleOf, type Entry } from "../lib/entries";
import { videoHtml } from "../lib/video.mjs";

interface Props {
  entry: Entry;
  /** On the home feed: the summary and first image or clip instead of the body, linking to the entry's page */
  preview?: boolean;
}

const { entry, preview = false } = Astro.props;
const { tag, when, links, summary } = entry.data;
const title = titleOf(entry);
const { Content } = await render(entry);
const media = preview ? firstMedia(entry) : undefined;
// A project without a tag still says what it is
const kind = tag ?? (sectionOf(entry) === "projects" ? "project" : undefined);

// Below lg, projects and journal entries trade the site header for a link home (global.css)
const backHome = !preview && ["projects", "journal"].includes(sectionOf(entry));

// The feed has many entries, so only a lone entry gets the page's h1
const Heading = preview ? "h2" : "h1";
---

<article class="max-w-[620px]">
  {
    backHome && (
      <a
        href="/"
        class="mb-8 block w-fit text-ui text-ink underline decoration-1 underline-offset-[3px] lg:hidden"
        data-back-home
      >
        home
      </a>
    )
  }
  <Heading class="font-serif text-[1.875rem]/[2.25rem] font-bold tracking-[-0.01em] text-ink sm:text-title">
    {
      preview ? (
        <a href={`/${entry.id}`} class="hover:underline hover:decoration-1 hover:underline-offset-[5px]">
          {title}
        </a>
      ) : (
        title
      )
    }
  </Heading>
  {
    // The feed leaves the meta line to the entry's page; the index already shows tag and years
    !preview && (
      <p class="mt-1.5 flex flex-wrap gap-x-[1em] font-mono text-meta text-muted">
        {kind && <span>{kind}</span>}
        <span>{when}</span>
        {links.map((link) => (
          <a
            href={link.href}
            target={link.href.startsWith("http") ? "_blank" : undefined}
            rel={link.href.startsWith("http") ? "noopener" : undefined}
            class="text-ink-soft hover:underline hover:underline-offset-[3px]"
          >
            {link.label} ↗
          </a>
        ))}
      </p>
    )
  }
  <div class:list={["prose", preview ? "mt-4" : "mt-7"]}>
    {
      preview ? (
        <>
          <p>{summary}</p>
          {media && (
            <a href={`/${entry.id}`} class="mt-6 block" tabindex="-1" aria-hidden="true">
              {media.kind === "video" ? (
                <Fragment set:html={videoHtml(media.src, media.alt)} />
              ) : (
                <Image src={media.src} alt={media.alt} widths={[620, 1240]} sizes="(min-width: 1024px) 620px, 100vw" />
              )}
            </a>
          )}
        </>
      ) : (
        <Content />
      )
    }
  </div>
</article>
