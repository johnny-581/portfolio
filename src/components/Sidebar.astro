<!-- Fixed to the left edge from lg up, on every page that has one. Hover thumbnails can
     show over it (see lib/preview.ts). The page's content goes in the slot; the clock
     sits at the bottom. -->
<aside class="px-6 pt-16 lg:fixed lg:inset-y-0 lg:left-0 lg:flex lg:w-(--sidebar) lg:flex-col lg:pt-24 lg:pb-12" data-sidebar>
  <!-- Centered in the sidebar; at full width that's Figma's 55px inset -->
  <div class="max-w-[280px] lg:mx-auto lg:w-full">
    <slot />
  </div>

  <p class="mt-10 min-h-6 max-w-[280px] lg:mx-auto lg:mt-auto lg:w-full" data-clock></p>
</aside>

<script>
  const time = new Intl.DateTimeFormat("en-US", { timeZone: "America/Vancouver", hour: "numeric", minute: "2-digit" });

  document.addEventListener("astro:page-load", () => {
    const clock = document.querySelector<HTMLElement>("[data-clock]");
    if (!clock) return;

    // Tick on each minute boundary
    let timer: number | undefined;
    const tick = () => {
      clock.textContent = `Vancouver · ${time.format(new Date())}`;
      timer = window.setTimeout(tick, 60_000 - (Date.now() % 60_000));
    };
    tick();
    document.addEventListener("astro:before-swap", () => clearTimeout(timer), { once: true });
  });
</script>
