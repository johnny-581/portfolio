---
import Header from "./Header.astro";
import Index from "./Index.astro";

interface Props {
  /** Path of the open page ("projects/whisk"); none on the home page */
  current?: string;
}

const { current } = Astro.props;
---

<!-- From lg up this is the left pane: sticky, scrolling on its own if the index is taller than the
     window. Below lg it has no box of its own, so the header and index become siblings of <main>
     and can be ordered around it (header, article, index). It persists across pages, so the
     avatar and the index don't re-render when you move between entries.
     Its top padding is main's 40px less the 12px of empty space above the avatar's head, so the
     head lines up with the first line of the page. -->
<aside
  class="contents lg:block lg:sticky lg:top-0 lg:h-dvh lg:overflow-y-auto lg:pt-7 lg:pr-8 lg:pb-12 lg:pl-10 no-scrollbar"
  transition:persist="aside"
  data-aside
>
  <!-- Hidden below lg on project and journal pages, which have a "home" link instead (global.css) -->
  <div class="column order-1 pt-6 lg:order-none lg:max-w-none lg:px-0 lg:pt-0" data-aside-header>
    <Header current={current} />
  </div>
  <div class="column order-3 pb-16 before:mb-6 before:block before:border-t before:border-line lg:order-none lg:mt-12 lg:max-w-none lg:px-0 lg:pb-0 lg:before:hidden">
    <Index current={current} />
  </div>
</aside>

<script>
  // The aside is kept between pages, so point its "current" marks at the new page, and keep
  // its scroll position (moving a node can reset it)
  let scroll = 0;
  let startOver = false;

  document.addEventListener("astro:before-swap", (e) => {
    scroll = document.querySelector<HTMLElement>("[data-aside]")?.scrollTop ?? 0;
    // One column (below lg): the window scrolls and the index sits at the bottom of it. The
    // tapped index link keeps focus across the swap and the router re-focuses it, which scrolls
    // it into view, so the new page would open at the index. Drop that focus first. (Back and
    // forward keep it, along with the scroll position they restore.)
    startOver = e.navigationType !== "traverse" && !matchMedia("(min-width: 1024px)").matches;
    if (startOver && document.activeElement?.closest("[data-aside]")) {
      (document.activeElement as HTMLElement).blur();
    }
  });
  document.addEventListener("astro:after-swap", () => {
    const aside = document.querySelector<HTMLElement>("[data-aside]");
    if (aside) aside.scrollTop = scroll;
    // Start focus (and the next Tab) at the top of the new page, not on a link that's out of view
    const main = document.querySelector<HTMLElement>("main");
    if (startOver && main) {
      main.tabIndex = -1;
      main.style.outline = "none";
      main.focus({ preventScroll: true });
    }
  });
  document.addEventListener("astro:page-load", () => {
    const slug = location.pathname.replace(/^\/|\/$/g, "");
    document.querySelectorAll<HTMLElement>("[data-aside] a[data-slug]").forEach((a) => {
      if (a.dataset.slug === slug) a.setAttribute("aria-current", "page");
      else a.removeAttribute("aria-current");
    });
  });
</script>
