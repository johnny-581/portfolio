---
import EntryIndex from "./EntryIndex.astro";
import { getEntries, SECTIONS } from "../lib/entries";

interface Props {
  /** Path of the open page ("projects/whisk"); none on the home page */
  current?: string;
}

const { current } = Astro.props;
const sections = await Promise.all(SECTIONS.map(async (section) => ({ section, entries: await getEntries(section) })));
---

<div class="flex flex-col gap-10">
  {sections.map(({ section, entries }) => <EntryIndex label={section} entries={entries} current={current} />)}
</div>
