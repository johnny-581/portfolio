---
import EntryIndex from "./EntryIndex.astro";
import { getEntries, SECTIONS } from "../lib/entries";

const sections = await Promise.all(SECTIONS.map(async (section) => ({ section, entries: await getEntries(section) })));
---

<div class="flex flex-col gap-10">
  {sections.map(({ section, entries }) => <EntryIndex label={section} entries={entries} />)}
  {/* The feed's keys (index.astro) and an entry's (the [...path] page), for people reading with a
      keyboard. Only where there's likely one: wide screens with a mouse or trackpad. */}
  <p class="hidden gap-x-2 font-mono text-meta text-muted lg:pointer-fine:flex">
    <span><kbd class="text-ink-soft">j</kbd> <kbd class="text-ink-soft">k</kbd>&ensp;move</span>
    <span aria-hidden="true">·</span>
    <span><kbd class="text-ink-soft">enter</kbd>&ensp;open</span>
    <span aria-hidden="true">·</span>
    <span><kbd class="text-ink-soft">esc</kbd>&ensp;back</span>
  </p>
</div>
